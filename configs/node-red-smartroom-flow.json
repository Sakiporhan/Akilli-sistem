  {
    "id": "quick_actions_fn",
    "type": "function",
    "z": "smartroom_tab",
    "name": "Quick Actions To MQTT",
    "func": "const action = msg.payload?.action || '';\nconst count = Number(msg.payload?.count || 1);\nconst roomId = 'room1';\n\nconst mk = (eventType, topic) => ({\n    topic,\n    payload: {\n        event_type: eventType,\n        timestamp: new Date().toISOString(),\n        room_id: roomId,\n        source: 'dashboard_quick_action',\n        confidence: 1.0,\n    },\n});\n\nif (action === 'entries') {\n    for (let i = 0; i < count; i++) {\n        node.send(mk('entry', 'building/room1/entry'));\n    }\n    return null;\n}\n\nif (action === 'exits') {\n    for (let i = 0; i < count; i++) {\n        node.send(mk('exit', 'building/room1/exit'));\n    }\n    return null;\n}\n\nif (action === 'fire') {\n    return mk('fire', 'building/room1/emergency');\n}\n\nreturn null;",
    "outputs": 1,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 360,
    "y": 380,
    "wires": [["quick_actions_out"]]
  },
