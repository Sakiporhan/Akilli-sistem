  {
    "id": "occupancy_text_fn",
    "type": "function",
    "z": "smartroom_tab",
    "name": "Occupancy Text",
    "func": "const occupancy = msg.payload.occupancy ?? 0;\nconst emergencyText = msg.payload.emergency === true ? 'Acil durum var' : 'Acil durum yok';\nmsg.payload = `Doluluk: ${occupancy} | Acil Durum: ${emergencyText}`;\nreturn msg;",
