    "type": "function",
    "z": "smartroom_tab",
    "name": "Emergency Card",
    "func": "const emergency = msg.payload.emergency === true;\nconst reason = msg.payload.last_emergency_reason || 'yok';\nconst occupancy = msg.payload.occupancy ?? 0;\nmsg.payload = emergency\n    ? `ACIL DURUM AKTIF | Neden: ${reason} | Doluluk: ${occupancy}`\n    : `SISTEM NORMAL | Son Uyari: ${reason} | Doluluk: ${occupancy}`;\nreturn msg;",
    "outputs": 1,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
