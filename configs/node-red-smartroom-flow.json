    "type": "function",
    "z": "smartroom_tab",
    "name": "Alert Text",
    "func": "const hasFire = (msg.payload.last_emergency_reason || '').toLowerCase() === 'fire';\nmsg.payload = hasFire ? 'Uyari: Yangin var' : 'Uyari: Yangin yok';\nreturn msg;",
    "outputs": 1,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 520,
    "y": 40,
