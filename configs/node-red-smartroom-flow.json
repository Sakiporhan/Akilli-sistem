    "name": "Status Text",
    "func": "const lastEventType = (msg.payload.last_event_type || '').toLowerCase();\nconst eventText = lastEventType === 'fire' ? 'Yangin' : 'Yangin yok';\nconst updatedAt = msg.payload.updated_at ? new Date(msg.payload.updated_at).toLocaleString('tr-TR', { timeZone: 'Europe/Istanbul' }) : '-';\nmsg.payload = `Son Olay: ${eventText} | Guncellendi: ${updatedAt}`;\nreturn msg;",
