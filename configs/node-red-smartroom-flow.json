  {
    "id": "history_fn",
    "type": "function",
    "z": "smartroom_tab",
    "name": "Event History Build",
    "func": "let history = flow.get('eventHistory') || [];\nconst updatedAt = msg.payload.updated_at ? new Date(msg.payload.updated_at).toLocaleString('tr-TR', { timeZone: 'Europe/Istanbul' }) : '-';\nconst eventType = msg.payload.last_event_type || 'beklemede';\nconst occ = msg.payload.occupancy ?? 0;\nconst emg = msg.payload.emergency === true ? 'evet' : 'hayir';\nconst line = `${updatedAt} | olay:${eventType} | doluluk:${occ} | acil:${emg}`;\nif (!history.length || history[history.length - 1] !== line) {\n    history.push(line);\n}\nif (history.length > 12) {\n    history = history.slice(history.length - 12);\n}\nflow.set('eventHistory', history);\nmsg.payload = history.slice().reverse().join('\\n');\nreturn msg;",
    "outputs": 1,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 540,
    "y": 460,
    "wires": [["history_ui"]]
