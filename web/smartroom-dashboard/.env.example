# MQTT köprüsü (FastAPI). Varsayılan: http://127.0.0.1:8765
# VITE_BRIDGE_ORIGIN=http://127.0.0.1:8765
# Sadece port (geliştirmede WebSocket doğrudan buna gider): VITE_BRIDGE_PORT=8765

# VITE_ROOM_ID=room1

# Doluluk >= bu kişi sayısı → arayüzde "Yoğun saat" (MQTT peak_occupancy_threshold yoksa yedek).
# VITE_PEAK_OCCUPANCY_THRESHOLD=5
